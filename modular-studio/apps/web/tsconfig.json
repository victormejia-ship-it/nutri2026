{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ms/domain": ["../../packages/domain/src/index.ts"],
      "@ms/geometry": ["../../packages/geometry/src/index.ts"],
      "@ms/cut-optimizer": ["../../packages/cut-optimizer/src/index.ts"],
      "@ms/export": ["../../packages/export/src/index.ts"],
      "@ms/db": ["../../packages/db/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
