# Copiar a apps/web/.env.production.local y pegar la configuración web de tu proyecto Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → Web → Configuración del SDK).
# Estas claves son públicas por diseño; la seguridad la dan Firebase Auth y firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=modular-studio-mx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=modular-studio-mx
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=modular-studio-mx.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
