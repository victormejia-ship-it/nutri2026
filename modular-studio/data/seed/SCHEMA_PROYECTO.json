{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proyecto Modular Studio (esquema mínimo)",
  "type": "object",
  "required": ["schemaVersion", "id", "currency", "unit", "assemblies"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "id": {"type": "string", "minLength": 1},
    "currency": {"const": "MXN"},
    "unit": {"const": "mm"},
    "assemblies": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "familyId", "widthMm", "heightMm", "depthMm", "thicknessMm"],
      "properties": {"id": {"type": "string"}, "familyId": {"type": "string"}, "widthMm": {"type": "number", "exclusiveMinimum": 0}, "heightMm": {"type": "number", "exclusiveMinimum": 0}, "depthMm": {"type": "number", "exclusiveMinimum": 0}, "thicknessMm": {"type": "number", "exclusiveMinimum": 0}}
    }}
  }
}
