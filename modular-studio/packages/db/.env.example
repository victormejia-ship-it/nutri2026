# Persistencia: "file" (modo demo, archivo JSON local) o "prisma" (PostgreSQL)
DATA_BACKEND=file
# Carpeta del archivo demo (por defecto apps/web/.data)
# DATA_DIR=/var/lib/modular-studio

# PostgreSQL (requerido si DATA_BACKEND=prisma). Copiar también a packages/db/.env para la CLI de Prisma.
DATABASE_URL="postgresql://ms:ms@localhost:5432/modular_studio?schema=public"

# Autenticación de la API: "demo" (un workspace local, rol ADMIN) o "token"
AUTH_MODE=demo
DEMO_WORKSPACE_ID=demo
# Con AUTH_MODE=token: lista "token:workspace:ROL" separada por comas (ROL: ADMIN|DESIGNER|CARPENTER|BUYER|VIEWER)
# API_TOKENS=cambia-este-token:demo:ADMIN

NEXT_TELEMETRY_DISABLED=1
