rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Perfiles de usuario. El rol nunca puede modificarse desde el propio
    // documento del usuario: solo un admin puede cambiarlo.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == 'usuario';
      allow update: if isAdmin() ||
        (isOwner(uid) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Planes: visibles para todos (landing pública), editables solo por admin.
    match /planes/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Recetas/blog: visibles para todos, editables solo por admin.
    match /recetas/{recetaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Citas: cada usuario ve y crea solo las suyas; el admin ve y gestiona todas.
    match /citas/{citaId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.usuarioId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.usuarioId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.usuarioId == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
